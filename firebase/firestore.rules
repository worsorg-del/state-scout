rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only allowlisted family accounts may use sync, and each signed-in
    // player can read and write only their own progress doc.
    match /players/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'bryan.m.worsley@gmail.com',
          'wizzlekvids@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
